# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo a `server/.env` y completá los valores.
#
# Cada variable dice si es OBLIGATORIA PARA ARRANCAR (el server aborta con un
# error claro si falta, ver lib/env.ts) o si sólo hace falta para una parte.
# Las que no son obligatorias están agrupadas por la fase que habilitan, así
# queda claro por qué un `.env` con 6 variables igual levanta la app.
#
# Esta lista tiene 18 variables; el server/.env de desarrollo define 7, que es
# lo mínimo para arrancar: base de datos, sesiones, entorno, puerto, CORS y correo.
#
# EN PRODUCCIÓN (NODE_ENV=production) el server además no arranca sin:
# TOKEN_ENCRYPTION_KEY (64 hex), MP_WEBHOOK_SECRET, MP_CLIENT_ID,
# MP_CLIENT_SECRET, RESEND_API_KEY, CORS_ORIGIN (sin "*"), APP_URL y
# API_PUBLIC_URL (https y públicas, no localhost) y TRUST_PROXY explícito.
# Cada faltante aparece en el error de arranque (lib/env.ts).
# ─────────────────────────────────────────────────────────────────────────────

# ═══ OBLIGATORIO PARA ARRANCAR ═══

# PostgreSQL corre vía docker-compose desde la raíz del repo.
# La password debe coincidir con POSTGRES_PASSWORD definida en el .env raíz
# (docker-compose.yml la usa para levantar el contenedor).
DATABASE_URL="postgresql://postgres:truckpool@localhost:5433/truckpool"

# Firma y verificación de los JWT de sesión. Generar con: openssl rand -hex 32
# Si falta, queda vacío, o es el valor de desarrollo que estuvo hardcodeado en
# el código, el proceso aborta: con el fallback viejo, cualquiera podía firmar
# un token de admin.
JWT_SECRET="cambiar-este-secreto-por-uno-largo"

# `development` acá, `production` en el despliegue (vitest pone `test` solo).
# Si falta o es otro valor, el proceso aborta: sin él el server se cree fuera de
# producción y monta los diagnósticos de Mercado Pago.
NODE_ENV=development

# ═══ ARRANQUE: tienen valor por defecto, se ajustan según el entorno ═══

# Puerto del API.
PORT=4000

# Orígenes del browser permitidos por CORS, separados por coma. Tiene que
# incluir el del front (5173 en dev).
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Tareas periódicas (lib/jobs.ts): outbox de reembolsos, reservas vencidas,
# auto-cancelación de viajes que no salieron y conciliación de pagos con MP.
# Por defecto prendidas; "false" las apaga. Solo acepta true, false o vacío:
# otro valor impide arrancar. Al arrancar, el log dice si quedaron prendidas
# o apagadas. En local, false mientras haya
# fleteros conectados a cuentas reales de MP: los jobs devuelven y concilian
# plata de verdad contra la base de desarrollo.
JOBS_ENABLED=true

# ═══ PAGOS (Mercado Pago) — sin esto no hay checkout, el resto de la app anda ═══

# Token de la cuenta de Mercado Pago (empieza por TEST-... en el sandbox).
# Sin él, POST /payments/preference falla al usarse; no al arrancar.
MP_ACCESS_TOKEN=""

# Secreto de la firma que manda Mercado Pago en el webhook. Se define en el
# panel de la app; NO es el mismo que el access token. Sin él los webhooks se
# rechazan por firma inválida y los pagos nunca se confirman solos.
MP_WEBHOOK_SECRET=""

# Credenciales de la app de Marketplace, para el OAuth con el que cada
# transportista conecta su cuenta de MP. Sin ellas, publicar un viaje falla
# (no se puede cobrar con split) pero el resto de la app funciona.
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""

# true: el OAuth pide credenciales de sandbox (test_token=true en /oauth/token),
# para conectar cuentas de prueba de MP. Solo para probar: con
# NODE_ENV=production y true el server no arranca. Valores: true o false
# (vacío = false).
MP_OAUTH_TEST_TOKEN="false"

# true manda el checkout de la seña y del saldo al link de sandbox de Mercado
# Pago (sandbox_init_point) en vez del real (init_point). Solo para probar con
# usuarios de prueba; con NODE_ENV=production y true el server no arranca.
# Valores: true o false (vacío = false).
MP_CHECKOUT_SANDBOX="false"

# URL pública del front. Mercado Pago redirige al checkout y al callback del
# OAuth por su cuenta, así que en local (localhost) no llega nunca: hace falta
# un túnel HTTPS para probar pagos de punta a punta.
APP_URL="http://localhost:5173"

# URL pública del API. Tiene que ser alcanzable desde internet para que
#Mercado Pago alcance el webhook, y cambiar API_PUBLIC_URL con la app ya
# levantada rompe el pago a mitad de camino.
API_PUBLIC_URL="http://localhost:4000"

# ═══ CIFRADO DE SECRETOS DE TERCEROS ═══

# 64 chars hex (32 bytes) para AES-256-GCM. Generar con: openssl rand -hex 32
# Con esto se cifra el access token de MP que guarda el OAuth del transportista.
# Sin la clave el OAuth no puede guardar nada; si cambia, hay que volver a
# conectar todas las cuentas (el token guardado deja de descifrarse y el pago
# falla explícito, nunca en silencio).
TOKEN_ENCRYPTION_KEY=""

# ═══ VERIFICACIÓN DE IDENTIDAD ═══

# Resend — emails transaccionales. La capa gratuita (3.000 emails/mes) alcanza
# para dev. Si falta, lib/email.ts loguea y sigue: los emails son
# best-effort y nunca rompen la operación de negocio.
RESEND_API_KEY=""
EMAIL_FROM="TruckPool <notificaciones@truckpool.app>"

# ═══ GEOCODIFICACIÓN (Nominatim / OpenStreetMap) ═══

# Resuelve direcciones al publicar un viaje y para la búsqueda por radio. Las
# consultas salen encoladas de a una por segundo y se cachean 24 h.
# El User-Agent es obligatorio para el uso laico de Nominatim.
NOMINATIM_URL="https://nominatim.openstreetmap.org/search"
NOMINATIM_USER_AGENT="TruckPool/1.0 (contacto@truckpool.app)"

# ═══ RATE LIMIT Y PROXIES ═══

# Cuántos proxies hay delante de la API. El rate limiter lee la IP real de
# X-Forwarded-For, así que esto tiene que ser el número de saltos exacto: en
# local no hay ninguno (vacío, 0 o false). En producción es OBLIGATORIO y tiene
# que coincidir con los proxies del hosting elegido (casi siempre 1): de más,
# cualquiera falsifica su IP; de menos, todos comparten el límite del proxy.
# Valores: un entero ≥ 0, true (= 1) o false (= 0); otro valor no arranca.
TRUST_PROXY=""

# Intentos de login y de registro por IP cada 15 minutos. Vacío = 10.
AUTH_RATE_LIMIT_MAX=""

# Rate limits de reservas, pagos, mensajes, solicitudes, tracking, geocode,
# cotizaciones y mapa (lib/rateLimit.ts, en memoria: una sola instancia).
# Vacío u "on" = prendidos; "off" los apaga solo para pruebas locales y en
# producción no arranca. Otro valor tampoco arranca.
RATE_LIMITS=""

# ── Admin (npm run admin:create) ─────────────────────────────────────────────
# El admin de producción se crea con `npm run admin:create` (el seed demo no
# corre en producción). Lo recomendado es correrlo SIN estas variables: pide el
# email y la contraseña por la terminal, sin eco. ADMIN_PASSWORD por variable
# puede quedar en el historial de la terminal o en este archivo: usala solo
# donde no haya terminal y borrala después. Mínimo 16 caracteres.
# Ver `npm run admin:create -- --help`.
# ADMIN_EMAIL=""
# ADMIN_NAME=""
# ADMIN_PASSWORD=""
