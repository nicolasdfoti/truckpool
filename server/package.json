{
  "name": "server",
  "version": "1.0.0",
  "description": "API de TruckPool",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"lib/**/*.ts\" \"modules/**/*.ts\" \"tests/**/*.ts\" \"prisma/**/*.ts\" \"*.{ts,json}\"",
    "db:seed": "tsx prisma/seed.ts",
    "seed:geocode": "tsx prisma/backfill-geocode.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@turf/turf": "^7.1.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^3.6.1",
    "pdfkit": "^0.20.2",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.6.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.5.3",
    "prisma": "^7.10.0",
    "supertest": "^7.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true
  }
}
